# Settings for arr_rename.py. Copy this to .env next to the script and fill it in:
#   cp .env.example .env && chmod 600 .env
# Variables already set in the shell win over this file, and command-line options win over both.
# Optional settings can be left empty.

# arr_rename.py sonarr
# If you don't name main instance it always runs first otherwise alphabetically
SONARR_URL=http://192.168.1.10:8989
SONARR_API_KEY=
# Leave series with this tag alone (optional)
SONARR_IGNORE_TAG=
# batched runs (optional): SONARR_RENAME_COUNT is the batch size, how many series each run checks
# (empty or 0: all of them). Each one checked is tagged SONARR_RENAME_TAG (default rename-checked), so the next run
# checks the next batch; the run that checks the last of them removes the tag, so a new pass starts from the top.
# The tag can only have letters, digits and -, and can't be SONARR_IGNORE_TAG.
SONARR_RENAME_COUNT=
SONARR_RENAME_TAG=
# rename limit (optional): rename at most this many series each run, leaving the rest for the next runs
# (empty or 0: no limit). No tag needed: the ones renamed then match, so the next run goes on to the rest.
SONARR_RENAME_MAX=

# More Sonarrs, each with a name of your choice (here "anime"). A run checks every one in turn
# --instance NAME checks just one. Optional.
# SONARR_ANIME_URL=http://192.168.1.10:8990
# SONARR_ANIME_API_KEY=
# SONARR_ANIME_IGNORE_TAG=
# SONARR_ANIME_RENAME_COUNT=
# SONARR_ANIME_RENAME_TAG=
# SONARR_ANIME_RENAME_MAX=

# arr_rename.py radarr
RADARR_URL=http://192.168.1.10:7878
RADARR_API_KEY=
# Leave movies with this tag alone (optional)
RADARR_IGNORE_TAG=
# batched runs (optional): RADARR_RENAME_COUNT is the batch size, how many movies each run checks
# (empty or 0: all of them). Each one checked is tagged RADARR_RENAME_TAG (default rename-checked), so the next run
# checks the next batch; the run that checks the last of them removes the tag, so a new pass starts from the top.
# The tag can only have letters, digits and -, and can't be RADARR_IGNORE_TAG.
RADARR_RENAME_COUNT=
RADARR_RENAME_TAG=
# rename limit (optional): rename at most this many movies each run, leaving the rest for the next runs
# (empty or 0: no limit). No tag needed: the ones renamed then match, so the next run goes on to the rest.
RADARR_RENAME_MAX=

# More Radarrs. Optional.
# RADARR_4K_URL=http://192.168.1.10:7879
# RADARR_4K_API_KEY=
# RADARR_4K_IGNORE_TAG=
# RADARR_4K_RENAME_COUNT=
# RADARR_4K_RENAME_TAG=
# RADARR_4K_RENAME_MAX=

# Post each run's results to this Discord webhook (Server Settings > Integrations > Webhooks). Optional.
DISCORD_WEBHOOK_URL=
# Your Discord user id, pinged when renames need an --interactive run or were forced, or a run can't start. Optional.
# Turn on Developer Mode (Settings > Advanced), then right-click your name > Copy User ID.
DISCORD_USER_ID=
