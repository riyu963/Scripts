# Settings for arr_rename.py, arr_upgrade_search.py and arr_blocklist_cleanup.py. Copy this to .env next to the scripts and fill it in:
#   cp .env.example .env && chmod 600 .env
# Variables already set in the shell win over this file, and command-line options win over both.
# Optional settings can be left empty.

# ===== Sonarr =====
# If you don't name main instance it always runs first otherwise alphabetically
SONARR_URL=http://192.168.1.10:8989
SONARR_API_KEY=

# --- arr_rename.py sonarr ---
# Leave series with this tag alone (optional)
SONARR_IGNORE_TAG=
# batched runs (optional): SONARR_RENAME_COUNT is the batch size, how many series each run checks
# The tag can only have letters, digits and -, and can't be SONARR_IGNORE_TAG or either of arr_upgrade_search.py's tags.
SONARR_RENAME_COUNT=
SONARR_RENAME_TAG=
# rename limit (optional): rename at most this many series each run, leaving the rest for the next runs
# (empty or 0: no limit). No tag needed.
SONARR_RENAME_MAX=

# --- arr_upgrade_search.py sonarr ---
# How many series to search each run, 1 to 500. Needed (or --count): without it no series are searched.
SONARR_UPGRADE_COUNT=10
# The tag that marks one searched (optional; default upgrade-searched; can't be the ignore tag or either of arr_rename.py's tags). The rest below are optional too
SONARR_UPGRADE_SEARCH_TAG=
# What to search: all (every one that's out, with files or not, the default), cutoff (below their cutoff) or missing
SONARR_UPGRADE_MODE=
# Only search monitored yes (only monitored, the default), no (only unmonitored), any (searches all)
SONARR_UPGRADE_MONITORED=
# Leave series with this tag alone (optional)
SONARR_UPGRADE_IGNORE_TAG=
# Only search those with these tags or quality profiles (comma-separated) (optional)
SONARR_UPGRADE_TAGS=
SONARR_UPGRADE_QUALITY_PROFILES=
# Only search those whose aired this many days ago or more (uses earliest air date) (optional)
SONARR_UPGRADE_AGE=
# add limit (optional): stop the run once this many searches have grabbed something, leaving the rest of the batch
# untagged for the next runs (empty or 0: no limit)
SONARR_UPGRADE_MAX_ADD=

# --- arr_blocklist_cleanup.py sonarr ---
# Which blocklist entries to remove (all optional; with none set, nothing is removed). Numbers: empty or 0 is off.
# Removed: entries blocklisted more than this many days ago
SONARR_BLOCKLIST_OLDER_THAN=
# Keep only the newest this many entries for each episode or season pack, the older ones removed
SONARR_BLOCKLIST_KEEP=
# At most this many entries in all, the oldest removed first
SONARR_BLOCKLIST_MAX=

# More Sonarrs, each with a name of your choice (here "anime"). A run checks every one in turn
# --instance NAME checks just one. Optional. Each can have any of the settings above, with its name after SONARR_.
# SONARR_ANIME_URL=http://192.168.1.10:8990
# SONARR_ANIME_API_KEY=
# SONARR_ANIME_IGNORE_TAG=
# SONARR_ANIME_RENAME_COUNT=
# SONARR_ANIME_RENAME_TAG=
# SONARR_ANIME_RENAME_MAX=
# SONARR_ANIME_UPGRADE_COUNT=10
# SONARR_ANIME_UPGRADE_MODE=
# SONARR_ANIME_UPGRADE_MAX_ADD=
# SONARR_ANIME_BLOCKLIST_OLDER_THAN=90
# SONARR_ANIME_BLOCKLIST_KEEP=

# ===== Radarr =====
RADARR_URL=http://192.168.1.10:7878
RADARR_API_KEY=

# --- arr_rename.py radarr ---
# Leave movies with this tag alone (optional)
RADARR_IGNORE_TAG=
# batched runs (optional): RADARR_RENAME_COUNT is the batch size, how many movies each run checks
# The tag can only have letters, digits and -, and can't be RADARR_IGNORE_TAG or either of arr_upgrade_search.py's tags.
RADARR_RENAME_COUNT=
RADARR_RENAME_TAG=
# rename limit (optional): rename at most this many movies each run, leaving the rest for the next runs
# (empty or 0: no limit). No tag needed.
RADARR_RENAME_MAX=

# --- arr_upgrade_search.py radarr ---
# How many movies to search each run, 1 to 500. Needed (or --count): without it no movies are searched.
RADARR_UPGRADE_COUNT=10
# The tag that marks one searched (optional; default upgrade-searched; can't be the ignore tag or either of arr_rename.py's tags). The rest below are optional too
RADARR_UPGRADE_SEARCH_TAG=
# What to search: all (every one that's out, with files or not, the default), cutoff (below their cutoff) or missing
RADARR_UPGRADE_MODE=
# Only search monitored yes (only monitored, the default), no (only unmonitored), any (searches all)
RADARR_UPGRADE_MONITORED=
# Leave movies with this tag alone (optional)
RADARR_UPGRADE_IGNORE_TAG=
# Only search those with these tags or quality profiles (comma-separated) (optional)
RADARR_UPGRADE_TAGS=
RADARR_UPGRADE_QUALITY_PROFILES=
# Only search those released this many days ago or more (uses earliest of in cinemas, digital and disc) (optional)
RADARR_UPGRADE_AGE=
# add limit (optional): stop the run once this many searches have grabbed something, leaving the rest of the batch
# untagged for the next runs (empty or 0: no limit)
RADARR_UPGRADE_MAX_ADD=

# --- arr_blocklist_cleanup.py radarr ---
# Which blocklist entries to remove (all optional; with none set, nothing is removed). Numbers: empty or 0 is off.
# Removed: entries blocklisted more than this many days ago
RADARR_BLOCKLIST_OLDER_THAN=
# Keep only the newest this many entries for each movie, the older ones removed
RADARR_BLOCKLIST_KEEP=
# At most this many entries in all, the oldest removed first
RADARR_BLOCKLIST_MAX=

# More Radarrs. Optional. Each can have any of the settings above, with its name after RADARR_.
# RADARR_4K_URL=http://192.168.1.10:7879
# RADARR_4K_API_KEY=
# RADARR_4K_IGNORE_TAG=
# RADARR_4K_RENAME_COUNT=
# RADARR_4K_RENAME_TAG=
# RADARR_4K_RENAME_MAX=
# RADARR_4K_UPGRADE_COUNT=10
# RADARR_4K_UPGRADE_MODE=
# RADARR_4K_UPGRADE_MAX_ADD=
# RADARR_4K_BLOCKLIST_OLDER_THAN=90
# RADARR_4K_BLOCKLIST_KEEP=

# ===== Discord (every script) =====
# Post each run's results to this Discord webhook (Server Settings > Integrations > Webhooks). Optional.
DISCORD_WEBHOOK_URL=
# Your Discord user id, pinged when renames need an --interactive run or were forced, or a run can't start, or (with
# arr_upgrade_search.py's or arr_blocklist_cleanup.py's --discord-ping) a search fails or grabs something, or blocklist
# entries are removed. Optional.
# Turn on Developer Mode (Settings > Advanced), then right-click your name > Copy User ID.
DISCORD_USER_ID=
